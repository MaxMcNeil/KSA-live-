# Regenerated fresh by the workflow on every run (npm install ...) — never
# needs to be committed. If it's already tracked in this repo, the workflow's
# "untrack node_modules" step (see update.yml) will remove it from git once.
node_modules/

# Debug artifacts capture.js writes only when a source site's selectors fail
# (fullPage screenshot + raw HTML dump, for troubleshooting a layout change)
debug_*.html
debug_*.png
